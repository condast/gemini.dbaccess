Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Automatic-Module-Name: org.apache.derby
Bundle-Name: Apache Derby JDBC
Bundle-SymbolicName: org.apache.derby
Bundle-Version: 10.8.2.2
Import-Package: javax.crypto,
 javax.crypto.spec,
 javax.naming,
 javax.naming.spi,
 javax.net,
 javax.sql,
 javax.transaction.xa,
 org.osgi.framework;version="1.3.0"
DynamicImport-Package: *
Bundle-RequiredExecutionEnvironment: JavaSE-1.6
Bundle-ClassPath: .,
 derby.jar,
 derbyclient.jar
Export-Package: org.apache.derby.authentication, 
 org.apache.derby.client,
 org.apache.derby.client.am,
 org.apache.derby.database,
 org.apache.derby.io,
 org.apache.derby.jdbc,
 org.apache.derby.vti
